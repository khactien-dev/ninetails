APP_NAME="Ninetails API"
APP_MODE=develop
APP_PORT=3000
APP_URL=http://localhost:3000
ASSET_URL=http://localhost:3000/assets
#service port
PORT_USER_SERVICE=3001
PORT_FORM_REQUEST_SERVICE=3003
PORT_LOCATION_SERVICE=3004
USER_SERVICE_APP=

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq:5672
RABBITMQ_HOST_API=rabbitmq:15672
RABBITMQ_STREAM_PORT=5552
RABBITMQ_STREAM_HOST_NAME=rabbitmq
RABBITMQ_STREAM_VHOST=/


# Database
DATABASE_TYPE=postgres
DATABASE_HOST=pgDb
DATABASE_PORT=5432
DATABASE_USERNAME=admin
DATABASE_PASSWORD=root
DATABASE_DATABASE=ninetails
DATABASE_SYNCHRONIZE=1

# Seed
SUPER_ADMIN_EMAIL=ninetails-admin@gmail.com
SUPER_ADMIN_DEFAULT_PASSWORD=Admin@12345
SUPER_ADMIN_DEFAULT_USERNAME=ninetails-admin

# JWT
COMMON_API_JWT_EXPIRES_IN=120000000000
COMMON_API_JWT_SECRET=ninetails-secret
COMMON_API_JWT_REFRESH_TOKEN_EXPIRES_IN=120000000000

# OPENSEARCH
cluster.name=opensearch-cluster
node.name=opensearch
discovery.seed_hosts=opensearch
cluster.initial_cluster_manager_nodes=opensearch
bootstrap.memory_lock=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
DISABLE_INSTALL_DEMO_CONFIG=true
DISABLE_SECURITY_PLUGIN=true
OPENSEARCH_HOSTS=["http://opensearch:9200"]
DISABLE_SECURITY_DASHBOARDS_PLUGIN=true
OPENSEARCH_SERVER=http://opensearch:9200

